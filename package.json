{
  "name": "linkzip",
  "version": "1.0.0",
  "description": "Client-side, zero-backend URL compressor & QR code optimizer",
  "type": "module",
  "main": "src/standalone.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node tests/roundtrip.test.js && node tests/extension.test.js && node tests/qr.test.js",
    "test:roundtrip": "node tests/roundtrip.test.js",
    "test:extension": "node tests/extension.test.js",
    "test:qr": "node tests/qr.test.js",
    "test:adapter": "vitest run tests/",
    "test:layout": "node scripts/verify-layout.mjs",
    "test:all": "npm test && npm run test:adapter && npm run test:layout"
  },
  "keywords": [
    "url-compressor",
    "qr-code",
    "huffman-coding",
    "client-side",
    "zero-backend"
  ],
  "author": "LinkZip Contributors",
  "license": "MIT",
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.0",
    "gsap": "^3.15.0",
    "jsqr": "^1.4.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.65.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
